,{"stream_name":"stdout","time":213.723546448,"data":": auto's shipped scorer is whichever of\n"}
,{"stream_name":"stdout","time":213.723608486,"data":"        head/cosine wins on the cal split. We assert the LOGIC (choice == cal\n"}
,{"stream_name":"stdout","time":213.723615121,"data":"        argmax) rather than a fragile stub outcome, and that the shipped scorer\n"}
,{"stream_name":"stdout","time":213.723619968,"data":"        and bundle artifact follow the choice.\"\"\"\n"}
,{"stream_name":"stdout","time":213.723624869,"data":"        from src.decision.adapt import adapt, AdaptConfig, split_indices\n"}
,{"stream_name":"stdout","time":213.723629701,"data":"        from src.decision.backends import StubEncoder\n"}
,{"stream_name":"stdout","time":213.723634742,"data":"        from src.decision.scoring import TaskHead\n"}
,{"stream_name":"stdout","time":213.723640311,"data":"        import numpy as np\n"}
,{"stream_name":"stdout","time":213.723645167,"data":"    \n"}
,{"stream_name":"stdout","time":213.723649843,"data":"        enc = StubEncoder(dim=32)\n"}
,{"stream_name":"stdout","time":213.723654832,"data":"        texts = [f\"topic{i % 3} text sample {i}\" for i in range(900)]\n"}
,{"stream_name":"stdout","time":213.723659568,"data":"        labels = [i % 3 for i in range(900)]\n"}
,{"stream_name":"stdout","time":213.723664348,"data":"        r = adapt(texts, labels, enc,\n"}
,{"stream_name":"stdout","time":213.723669117,"data":"                  cfg=AdaptConfig(scorer=\"auto\", seed=0, min_cal=100),\n"}
,{"stream_name":"stdout","time":213.723673817,"data":"                  out_dir=tmp_path)\n"}
,{"stream_name":"stdout","time":213.723678187,"data":"    \n"}
,{"stream_name":"stdout","time":213.72368278,"data":"        # recompute the cal argmax independently\n"}
,{"stream_name":"stdout","time":213.723688688,"data":"        X = enc.encode(texts)\n"}
,{"stream_name":"stdout","time":213.723705375,"data":"        y_idx = np.array(labels)\n"}
,{"stream_name":"stdout","time":213.723709503,"data":"        fi, ci, ti = split_indices(900, 0.5, 0.25, 0, y=y_idx)\n"}
,{"stream_name":"stdout","time":213.723712984,"data":"        classes = sorted(set(labels))\n"}
,{"stream_name":"stdout","time":213.723716482,"data":"        LV = enc.encode_options(classes)\n"}
,{"stream_name":"stdout","time":213.723719964,"data":"        cos_acc = float(((X[ci] @ LV.T).argmax(1) == y_idx[ci]).mean())\n"}
,{"stream_name":"stdout","time":213.723723854,"data":"        h = TaskHead()\n"}
,{"stream_name":"stdout","time":213.723727376,"data":"        h.fit(X[fi], y_idx[fi], labels=classes, seed=0)\n"}
,{"stream_name":"stdout","time":213.723730951,"data":"        head_acc = float((h.logits(X[ci]).argmax(1) == y_idx[ci]).mean())\n"}
,{"stream_name":"stdout","time":213.723734669,"data":"        expected = \"taskhead\" if head_acc \u003e= cos_acc else \"cosine\"\n"}
,{"stream_name":"stdout","time":213.723739229,"data":"    \n"}
,{"stream_name":"stdout","time":213.723742792,"data":"\u003e       assert r.report[\"scorer_choice\"] == expected\n"}
